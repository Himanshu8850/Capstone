# BookyGeek environment variables - names and safe placeholders ONLY.
# Copy to .env (git-ignored) and replace every CHANGE_ME value locally.
# Never commit real values.

# --- PostgreSQL ---
POSTGRES_DB=bookygeek
POSTGRES_USER=bookygeek_app
POSTGRES_PASSWORD=CHANGE_ME

# --- Backend datasource ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/bookygeek
SPRING_DATASOURCE_USERNAME=bookygeek_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# --- Authentication ---
# At least 32 random bytes, e.g. generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_TTL_MINUTES=60
# false only for plain-HTTP localhost; true wherever TLS terminates
COOKIE_SECURE=false

# --- Web ---
# Empty by default (same-origin or Vite dev proxy)
CORS_ALLOWED_ORIGINS=

# --- Runtime ---
# dev (loads seed data) | test | prod (schema migrations only)
SPRING_PROFILES_ACTIVE=dev
BOOKYGEEK_REWARDS_INITIAL_POINTS=1000

# --- Test accounts (used by backend, frontend and E2E tests; must be 8-64 chars with a letter and a digit) ---
# Pick any values; the wrong password must differ from the real one.
TEST_USER_PASSWORD=CHANGE_ME
TEST_USER_WRONG_PASSWORD=CHANGE_ME
